# Direct OIDC remote MCP gateway example.
# Do not commit real values.

PUBLIC_BASE_URL=https://mcp.organization.example.com
GATEWAY_UPSTREAM_URL=http://gongmcp:8080
GATEWAY_ADDR=:8090

OIDC_AUTH_PROFILE=direct-oidc
OIDC_ISSUER_URL=https://issuer.organization.example.com
# Set from the provider's OIDC discovery jwks_uri when it differs from the
# default issuer + "/.well-known/jwks.json" path.
OIDC_JWKS_URL=
OIDC_CLIENT_ID=replace-with-dedicated-oidc-app-client-id

# Use an exact scope that the provider puts in the access token and that the
# gateway and authorization-server metadata advertise.
OIDC_REQUIRED_SCOPE=replace-with-issued-access-token-scope
OIDC_SCOPES_SUPPORTED=replace-with-issued-access-token-scope

# Fail closed until exactly one policy block below is selected.
OIDC_REQUIRED_GROUP=
OIDC_REQUIRED_GROUPS=
OIDC_ALLOWED_GROUPS=
OIDC_GROUP_CLAIM=
OIDC_ALLOWED_SUBJECTS=
OIDC_ALLOWED_EMAILS=
OIDC_ALLOW_APP_ASSIGNMENT_ONLY=0

GATEWAY_DCR_ENABLED=0
# Leave empty when no browser-based hosted client sends an Origin header.
GATEWAY_ALLOWED_ORIGINS=https://hosted-client.example.com

GATEWAY_INTERNAL_BEARER_TOKEN_FILE=/run/secrets/gongmcp_token

# ---------------------------------------------------------------------------
# Select exactly one access-policy mode by editing the active policy keys above.
# Use the blocks below as value templates; do not add duplicate keys.
# Before deploying either block, remove stale legacy access-policy variables
# from the ConfigMap, Secret, environment file, and deployment automation:
#   COGNITO_REQUIRED_GROUP
#   COGNITO_REQUIRED_GROUPS
#   COGNITO_ALLOWED_GROUPS
#   COGNITO_ALLOWED_SUBJECTS
#   COGNITO_ALLOWED_EMAILS
# ---------------------------------------------------------------------------

# --- Group-gated direct OIDC values ----------------------------------------
# OIDC_REQUIRED_GROUP=replace-with-exact-access-token-group
# OIDC_REQUIRED_GROUPS=
# OIDC_ALLOWED_GROUPS=
# OIDC_GROUP_CLAIM=replace-with-access-token-group-claim
# OIDC_ALLOWED_SUBJECTS=
# OIDC_ALLOWED_EMAILS=
# OIDC_ALLOW_APP_ASSIGNMENT_ONLY=0
#
# For an any-of group list, leave OIDC_REQUIRED_GROUP empty and put the exact,
# comma-separated values in OIDC_REQUIRED_GROUPS. Group matching is
# case-sensitive.

# --- Dedicated-app assignment-only values ----------------------------------
# OIDC_REQUIRED_GROUP=
# OIDC_REQUIRED_GROUPS=
# OIDC_ALLOWED_GROUPS=
# OIDC_GROUP_CLAIM=
# OIDC_ALLOWED_SUBJECTS=
# OIDC_ALLOWED_EMAILS=
# OIDC_ALLOW_APP_ASSIGNMENT_ONLY=1
#
# Use only when the OIDC application/client is dedicated to this connector, the
# identity provider prevents unassigned users from obtaining tokens for the
# application, every assigned user is approved for the same read-only MCP
# surface, and the gateway still validates signature/algorithm, expiration,
# issuer, client binding, and the configured required scope.

# Leave disabled for direct OIDC. Uncomment and fill these only when the
# deployment explicitly chooses Cognito or needs Cognito-backed DCR fallback.
# GATEWAY_DCR_ENABLED=1
# COGNITO_DOMAIN_URL=https://your-domain.auth.us-east-1.amazoncognito.com
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COGNITO_DCR_ALLOWED_REDIRECT_URIS=https://hosted-client.example.com/oauth/callback
# COGNITO_DCR_ALLOWED_SCOPES=openid,email,replace-with-issued-access-token-scope
# COGNITO_DCR_IDENTITY_PROVIDERS=
# COGNITO_DCR_CLIENT_NAME_PREFIX=gongmcp-dcr
# COGNITO_DCR_ACCESS_TOKEN_MINUTES=60
